# Railway private-alpha env template — placeholders only, never real secrets.
# See docs/railway-deploy.md for full setup steps and exactly which vars each of the
# three services (API, Telegram bot, worker) actually needs.
#
# On Railway, set these as each SERVICE's own variables (Settings -> Variables), not as
# a single shared file — Railway has no concept of loading a .env file from the repo.
# This file exists purely as a reference/checklist to copy from.

# --- Database (Railway Postgres plugin) --------------------------------------------
# On Railway: reference the Postgres plugin's own variable instead of pasting a value —
# ${{Postgres.DATABASE_URL}} — so it never falls out of sync if Railway rotates it.
# Needed by: API, worker (runtime) — and by ALL THREE services at build time, since the
# shared build command builds the whole workspace (see docs/railway-deploy.md, task 1's
# ambiguity notes). Local dev fallback shown here only for reference.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alecto_ai?schema=public

# --- OpenAI (real LLM planner) -------------------------------------------------------
# Needed by: API only.
OPENAI_API_KEY=sk-REPLACE_ME
# Optional — override the default model (gpt-4o-mini) for the planner/guardrail:
# OPENAI_MODEL=gpt-4o-mini

# --- Telegram --------------------------------------------------------------------------
# Needed by: Telegram bot, worker.
TELEGRAM_BOT_TOKEN=REPLACE_ME_FROM_BOTFATHER
# Optional — restrict who can use the bot during alpha (comma-separated Telegram user ids):
# TELEGRAM_ALLOWED_USER_IDS=123456789

# --- Inter-service URL -----------------------------------------------------------------
# The API service's own public Railway URL. Needed by: Telegram bot, worker (they call the
# API over HTTP) — and by the API service itself, since it's also used to build the Gmail
# OAuth callback URL below. Set to the SAME value on all three services.
API_BASE_URL=https://REPLACE_ME.up.railway.app

# API service only — this app reads API_PORT, not Railway's own PORT convention. Set this
# explicitly and match it in the API service's Networking target port (see railway-deploy.md).
API_PORT=3000

# --- Gmail OAuth (API service only) -----------------------------------------------------
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME
# Must exactly match an Authorized redirect URI in Google Cloud Console.
GMAIL_REDIRECT_URI=https://REPLACE_ME.up.railway.app/oauth/gmail/callback

# --- Secret encryption (API service only) -----------------------------------------------
# Encrypts stored Gmail refresh tokens at rest. Generate once with:
#   openssl rand -base64 32
# then set the SAME value permanently — rotating it makes existing stored Gmail
# connections undecryptable (users would need to reconnect Gmail).
ALECTO_SECRET_ENCRYPTION_KEY=REPLACE_ME_32_BYTE_BASE64_KEY

# --- Gmail background sync (worker service) ---------------------------------------------
INTEGRATION_SYNC_ENABLED=true
INTEGRATION_SYNC_INTERVAL_MINUTES=60

# --- Proactive delivery (API + worker services) -----------------------------------------
# Developer rollout controls, not end-user-facing settings — see docs/10-v3-readiness-audit.md.
PROACTIVE_OPERATOR_DELIVERY_ENABLED=true
# Comma-separated allowlist, e.g. telegram:123456789 or the bare numeric id — get your own
# id from the bot via "/whoami". Leave unset/empty during alpha to allow every opted-in user;
# set explicitly once you know your own id, per railway-deploy.md's own recommendation.
PROACTIVE_OPERATOR_ALLOWLIST=

# --- Misc --------------------------------------------------------------------------------
# Not read anywhere in this app's own code (see docs/railway-deploy.md's ambiguity notes) —
# harmless to set, has no effect on Alecto's behavior either way.
NODE_ENV=production

# --- Never set these in production --------------------------------------------------------
# AGENT_RUNTIME_PLANNER_MOCK_RESPONSE, AGENT_RUNTIME_PLANNER_MOCK_THROW,
# AGENT_RUNTIME_GUARDRAIL_MOCK_RESPONSE, GMAIL_RULE_MATCH_LLM_MOCK_RESPONSE, and every other
# *_MOCK_* variable are TEST-ONLY hooks used by this repo's own test suite to fake LLM
# responses deterministically — setting any of them on a real deployment would replace real
# planning/classification with a fixed fake response for every user.
