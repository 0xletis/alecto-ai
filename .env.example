# Local development template. Copy to .env and fill in real values — this file is loaded by
# apps/api, apps/worker, and apps/telegram-bot's own `dotenv` config() call at startup.
# For a Railway production deploy, see .env.railway.example and docs/railway-deploy.md instead —
# defaults differ (see the "production defaults" notes below).

# --- API server -------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000

# --- OpenAI (real LLM planner / analysis / proactive brief personalization) -------------
# Required for any real LLM feature — every one of them falls back to a deterministic/heuristic
# path when this is unset, so local dev still works without it.
OPENAI_API_KEY=sk-yourkey
# Optional — override the default model (gpt-4o-mini):
OPENAI_MODEL=gpt-4o-mini
# Feature flags below explicitly turn each LLM feature on for local dev. In PRODUCTION
# (NODE_ENV=production) these now default ON automatically whenever OPENAI_API_KEY is present —
# an explicit true/false here always still wins on every environment.
DAILY_COACH_LLM_ENABLED=true
USE_OPENAI_ANALYSIS=true
LLM_ROUTER_ENABLED=true
LLM_ROUTER_MODEL=gpt-4o-mini
PROACTIVE_BRIEF_LLM_ENABLED=true

# --- Database ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alecto_ai?schema=public"

# --- Telegram --------------------------------------------------------------------------------
# Required — both the Telegram bot and the worker throw immediately at startup without this.
TELEGRAM_BOT_TOKEN=your-tg-token
# Optional — comma-separated Telegram user ids. Unset means anyone can talk to the bot AND
# disables every debug-only slash command (/debug_*) for everyone, including you.
TELEGRAM_ALLOWED_USER_IDS=userids
# Where the worker/telegram-bot reach the API. Must point at a real public URL in production.
API_BASE_URL=http://localhost:3000

# --- Proactive delivery / background sync (worker + API) -----------------------------------
# Explicit here for local dev. In PRODUCTION these now default ON automatically when unset — an
# explicit true/false always still wins. INTEGRATION_SYNC_ENABLED is a system-level switch only;
# it never makes a manual_only Gmail connection background-sync (that's a separate, per-connection
# setting — see packages/core/src/gmail-autonomy.ts).
PROACTIVE_OPERATOR_DELIVERY_ENABLED=true
INTEGRATION_SYNC_ENABLED=true
# Optional — comma-separated allowlist restricting WHO proactive messages actually go to, on top
# of their own per-user opt-in. Leave unset/empty to allow every opted-in user.
# PROACTIVE_OPERATOR_ALLOWLIST=

# Dev/debug only — gates internal [agent-runtime-diagnostics] console output. Never needed for
# real product behavior; defaults OFF (safe) if you remove this line.
AGENT_RUNTIME_DIAGNOSTICS=true

# --- Gmail OAuth ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-id
GOOGLE_CLIENT_SECRET=Gyour-google-secret
# The canonical name this app actually reads. (A legacy GOOGLE_REDIRECT_URI name is also
# supported as a fallback if you already have one set, but GMAIL_REDIRECT_URI always wins if both
# are present — see apps/api/src/gmail/oauth.ts.)
GMAIL_REDIRECT_URI=http://localhost:3000/oauth/gmail/callback

# --- Secret encryption -----------------------------------------------------------------------
# Required for Gmail token storage. Generate a real one with: openssl rand -base64 32
ALECTO_SECRET_ENCRYPTION_KEY=encr-key

# Not read anywhere in this app's own code — harmless to set, has no effect on behavior. Use the
# production-defaulted flags above (or set NODE_ENV=production yourself) to actually change
# runtime defaults.
NODE_ENV=development
