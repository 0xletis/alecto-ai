{
  "name": "operator-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "db:generate": "export DATABASE_URL=\"${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/alecto_ai?schema=public}\" && pnpm --filter @operator-agent/db db:generate",
    "db:migrate": "export DATABASE_URL=\"${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/alecto_ai?schema=public}\" && pnpm --filter @operator-agent/db db:migrate",
    "db:studio": "export DATABASE_URL=\"${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/alecto_ai?schema=public}\" && pnpm --filter @operator-agent/db db:studio",
    "dev:api": "export DATABASE_URL=\"${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/alecto_ai?schema=public}\" && pnpm --filter @operator-agent/core build && pnpm --filter @operator-agent/db build && pnpm --filter @operator-agent/api dev",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0"
}
