generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goals                Goal[]
  events               Event[]
  operatingProfile     UserOperatingProfile?
  pendingActions       PendingAction[]
  notificationSettings NotificationSettings?
  notificationLogs     NotificationLog[]
  dailyLoopStates      DailyLoopState[]
  memories             MemoryEntry[]
  integrationConnections IntegrationConnection[]
  integrationSyncLogs    IntegrationSyncLog[]
  emailSignalRules       EmailSignalRule[]
  emailReviewItems       EmailReviewItem[]
  actionItems            ActionItem[]
  actionItemReminderLogs ActionItemReminderLog[]
  agentConversationSessions AgentConversationSession[]
}

model Goal {
  id            String     @id @default(uuid())
  userId        String
  title         String
  category      String
  status        GoalStatus @default(active)
  priority      String     @default("medium")
  importanceScore Float?
  priorityReason String?
  why           String?
  templateId    String?
  targetMetrics Json?
  checkInConfig Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  // fix/private-alpha-goal-restore-ambiguity-resolution: when this goal was archived — set by
  // setGoalStatus on every transition TO "archived", cleared on every transition away from it.
  // Mirrors Event.archivedAt below; needed so goal.restore_propose's recency disambiguation
  // ("latest archived", "archived today") has a real, precise timestamp to sort/filter on rather
  // than the much noisier updatedAt (bumped by any field write, not just archiving).
  archivedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Event {
  id                 String   @id @default(uuid())
  userId             String
  type               String
  timestamp          DateTime
  source             String
  data               Json
  confidence         Float
  evidence           Json?
  status             String   @default("active")
  eventGroupId       String?
  archivedAt         DateTime?
  archiveReason      String?
  correctedByEventId String?
  externalId         String?
  provider           String?
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, timestamp])
  @@index([userId, eventGroupId])
  @@unique([userId, source, externalId])
}

model MemoryEntry {
  id         String   @id @default(uuid())
  userId     String
  type       String
  status     String   @default("active")
  summary    String
  data       Json?
  evidence   Json?
  source     String
  confidence Float    @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status, createdAt])
}

model UserOperatingProfile {
  id                       String   @id @default(uuid())
  userId                   String   @unique
  directness               Int      @default(3)
  warmth                   Int      @default(3)
  humor                    Int      @default(2)
  confrontation            Int      @default(3)
  verbosity                Int      @default(3)
  profanityAllowed         Boolean  @default(false)
  motivationalStyle        String   @default("strategic")
  accountabilityStrictness Int      @default(3)
  reminderFrequency        String   @default("medium")
  escalationStyle          String   @default("firm")
  requiresEvidence         Boolean  @default(true)
  gamblingGuardrails       String   @default("strict")
  selfDeceptionSensitivity Int      @default(4)
  cooldownPreference       String   @default("require_confirmation")
  vulnerableMode           String   @default("soften")
  avoidingMode             String   @default("challenge")
  impulsiveMode            String   @default("guardian_mode")
  effectivePhrases         Json?
  ineffectivePhrases       Json?
  knownTriggers            Json?
  knownFailureModes        Json?
  knownStrengths           Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PendingAction {
  id        String    @id @default(uuid())
  userId    String
  type      String
  status    String    @default("pending")
  summary   String
  payload   Json
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status, createdAt])
}

// Agent Runtime v3's persisted conversation/session state (topic, pending
// confirmation, visible entities, recent mutations, bounded message history).
// One row per (userId, channel). expiresAt is a sliding 24h TTL, refreshed on
// every turn — an expired row is treated as missing and a fresh session is
// created. Isolated from PendingAction/legacy conversation-control state.
model AgentConversationSession {
  id               String    @id @default(uuid())
  userId           String
  channel          String
  topic            String?
  focusedEntities  Json?
  pendingOperation Json?
  visibleEntities  Json?
  recentMutations  Json?
  messages         Json?
  // fix/private-alpha-launch-hardening-flakes-and-pending-clarity: a lightweight, additive-only
  // marker array for capability proposals the user explicitly declined/deferred (not now / cancel
  // / picked only one of several) — e.g. { proposalId: "daily_coaching", goalId, decidedAt }. Lets
  // goal.create_apply skip re-offering the same capability for the same goal again within this
  // same session's TTL, without any permanent suppression: nullable/defaulted, no backfill, and
  // scoped to the SAME session lifecycle (24h sliding TTL) every other pending-operation field
  // here already has, so a "not now" naturally becomes offerable again once the session expires
  // or the user explicitly asks in the meantime.
  deferredCapabilityProposals Json?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@index([userId])
}

model NotificationSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique
  telegramUserId       String?
  dailyCheckinEnabled  Boolean  @default(false)
  dailyCheckinTime     String?
  dailyInsightEnabled  Boolean  @default(false)
  dailyInsightTime     String?
  weeklyInsightEnabled Boolean  @default(false)
  weeklyInsightDay     String?
  weeklyInsightTime    String?
  dailyLoopEnabled     Boolean  @default(false)
  morningBriefEnabled  Boolean  @default(false)
  eveningCheckinEnabled Boolean @default(false)
  gmailNudgeEnabled    Boolean  @default(false)
  timezone             String   @default("Europe/Madrid")
  defaultActionTimeMinutes Int   @default(540)
  morningTimeMinutes       Int   @default(540)
  afternoonTimeMinutes     Int   @default(900)
  eveningTimeMinutes       Int   @default(1140)
  tonightTimeMinutes       Int   @default(1200)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyLoopState {
  id                       String   @id @default(uuid())
  userId                   String
  localDate                String
  timezone                 String   @default("Europe/Madrid")
  morningBriefSentAt       DateTime?
  middayNudgeSentAt        DateTime?
  eveningReviewSentAt      DateTime?
  eveningReviewCompletedAt DateTime?
  status                   String   @default("not_started")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, localDate])
}

model NotificationLog {
  id          String   @id @default(uuid())
  userId      String
  type        String
  sentForDate String
  sentAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, type, sentForDate])
}

model IntegrationConnection {
  id            String   @id @default(uuid())
  userId        String
  integrationId String
  status        String   @default("active")
  config        Json
  lastSyncedAt  DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncLogs IntegrationSyncLog[]
  emailSignalRules EmailSignalRule[]
  emailReviewItems  EmailReviewItem[]

  @@index([userId])
  @@index([userId, integrationId])
}

model IntegrationSyncLog {
  id            String    @id @default(uuid())
  userId        String
  connectionId  String
  integrationId String
  status        String
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  eventsCreated Int       @default(0)
  error         String?

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([connectionId])
}

model EmailSignalRule {
  id                  String    @id @default(uuid())
  userId              String
  connectionId        String
  goalId              String?
  // Generic goal-signal mapping (feat/gmail-rule-signal-mapping) — deliberately mirrors
  // GoalMetric's own signalKey XOR eventType convention (see packages/core/src/goals.ts):
  // eventType is a real, registered EventTypeSchema member (e.g. "career.recruiter_reply_
  // received"); signalKey is a custom, per-goal key the linked goal itself already declared in
  // its own targetMetrics (e.g. "endesa_bill_received"). At most one is ever set — code enforces
  // this, never both. Both null means this rule has no goal-evidence mapping at all (the pre-
  // existing, still-fully-supported "review/action only" behavior).
  signalKey           String?
  eventType           String?
  adapterId           String
  name                String
  query               String?
  status              String    @default("active")
  fetchStrategy       String    @default("query")
  lookbackDays        Int       @default(30)
  maxMessagesPerSync  Int       @default(25)
  maxEventsPerSync    Int       @default(10)
  classifierMode      String    @default("rules")
  minAutoLogConfidence Float    @default(0.9)
  minReviewConfidence Float     @default(0.65)
  reviewBeforeLogging Boolean   @default(false)
  // fix/private-alpha-gmail-generic-signal-engine: minimal, additive generalization fields so a
  // Gmail rule can represent ANY watch request (flights, insurance, bills, admin deadlines...),
  // not just the two job-search/work-action built-ins. All nullable/defaulted — every existing
  // row keeps working exactly as before with no backfill required. `domain` is a free-text coarse
  // category ("career", "travel", "insurance", "finance", "admin", "custom", ...) used for status
  // grouping and default priority, never a strict enum (a new domain should never need a schema
  // change). `description` is the fuller natural-language explanation of what counts as a match —
  // fed to the generic LLM rule-matcher (packages/llm/src/classify-email.ts) instead of that
  // matcher having to synthesize one from just the short `name`. `notifyPolicy` gates whether a
  // match under this rule is even eligible for a proactive gmail_nudge, independent of whether it
  // goes to review — "review_only" (the safe default) never nudges, "notify" allows it,  "silent"
  // suppresses even the review-count nudge line. A user must opt a rule INTO notify explicitly;
  // review-first behavior itself is unchanged.
  domain              String?
  description         String?
  notifyPolicy        String    @default("review_only")
  createdBy           String
  lastSyncedAt        DateTime?
  lastError           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  reviewItems EmailReviewItem[]

  @@index([userId])
  @@index([connectionId])
  @@index([userId, status])
}

model EmailReviewItem {
  id                 String    @id @default(uuid())
  userId             String
  connectionId       String
  ruleId             String
  adapterId          String
  provider           String
  providerMessageId  String
  externalId         String    @unique
  subject            String?
  from               String?
  snippet            String?
  evidence           String?
  proposedEventType  String?
  confidence         Float
  reason             String
  extracted          Json
  status             String    @default("pending")
  // fix/private-alpha-gmail-generic-signal-engine: `priority` generalizes what used to be a
  // job-search-only concept (HIGH_SIGNAL_JOB_SEARCH_EVENT_TYPES, i.e. only offer/interview could
  // ever be "high priority") — now the generic LLM rule-matcher and any adapter can mark a real
  // signal high priority (a flight cancellation, an insurance deadline), and gmail_nudge/status
  // read this field generically instead of a career.*-only check. Existing rows default to
  // "normal", so nothing already stored silently becomes high-priority. `domain` is copied from
  // the matching rule's own `domain` at creation time (denormalized on purpose — stable for
  // display/status grouping even if the rule is later edited or archived).
  priority           String    @default("normal")
  domain             String?
  eventId            String?
  actionItemId        String?
  archiveReason      String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  rule       EmailSignalRule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([ruleId, status])
}

model ActionItem {
  id             String    @id @default(uuid())
  userId         String
  source         String
  sourceId       String?
  sourceProvider String?
  sourceRuleId   String?
  goalId         String?
  goalSlug       String?
  goalTitleSnapshot String?
  title          String
  description    String?
  status         String    @default("open")
  priority       String    @default("medium")
  dueAt          DateTime?
  project        String?
  actionType     String?
  evidence       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?
  snoozedUntil   DateTime?
  postponeCount  Int       @default(0)

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminderLogs ActionItemReminderLog[]

  @@index([userId, status])
  @@index([userId, dueAt])
  @@index([userId, goalId])
  @@index([source, sourceId])
}

model ActionItemReminderLog {
  id           String   @id @default(uuid())
  userId       String
  actionItemId String
  reminderType String
  sentAt       DateTime @default(now())
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionItem ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([actionItemId, reminderType, sentAt])
}

enum GoalStatus {
  active
  paused
  archived
}
