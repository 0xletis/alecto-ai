generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goals                Goal[]
  events               Event[]
  operatingProfile     UserOperatingProfile?
  pendingActions       PendingAction[]
  notificationSettings NotificationSettings?
  notificationLogs     NotificationLog[]
  memories             MemoryEntry[]
  integrationConnections IntegrationConnection[]
  integrationSyncLogs    IntegrationSyncLog[]
  emailSignalRules       EmailSignalRule[]
  emailReviewItems       EmailReviewItem[]
  actionItems            ActionItem[]
  actionItemReminderLogs ActionItemReminderLog[]
}

model Goal {
  id            String     @id @default(uuid())
  userId        String
  title         String
  category      String
  status        GoalStatus @default(active)
  why           String?
  templateId    String?
  targetMetrics Json?
  checkInConfig Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Event {
  id                 String   @id @default(uuid())
  userId             String
  type               String
  timestamp          DateTime
  source             String
  data               Json
  confidence         Float
  evidence           Json?
  status             String   @default("active")
  eventGroupId       String?
  archivedAt         DateTime?
  archiveReason      String?
  correctedByEventId String?
  externalId         String?
  provider           String?
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, timestamp])
  @@index([userId, eventGroupId])
  @@unique([userId, source, externalId])
}

model MemoryEntry {
  id         String   @id @default(uuid())
  userId     String
  type       String
  status     String   @default("active")
  summary    String
  data       Json?
  evidence   Json?
  source     String
  confidence Float    @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status, createdAt])
}

model UserOperatingProfile {
  id                       String   @id @default(uuid())
  userId                   String   @unique
  directness               Int      @default(3)
  warmth                   Int      @default(3)
  humor                    Int      @default(2)
  confrontation            Int      @default(3)
  verbosity                Int      @default(3)
  profanityAllowed         Boolean  @default(false)
  motivationalStyle        String   @default("strategic")
  accountabilityStrictness Int      @default(3)
  reminderFrequency        String   @default("medium")
  escalationStyle          String   @default("firm")
  requiresEvidence         Boolean  @default(true)
  gamblingGuardrails       String   @default("strict")
  selfDeceptionSensitivity Int      @default(4)
  cooldownPreference       String   @default("require_confirmation")
  vulnerableMode           String   @default("soften")
  avoidingMode             String   @default("challenge")
  impulsiveMode            String   @default("guardian_mode")
  effectivePhrases         Json?
  ineffectivePhrases       Json?
  knownTriggers            Json?
  knownFailureModes        Json?
  knownStrengths           Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PendingAction {
  id        String    @id @default(uuid())
  userId    String
  type      String
  status    String    @default("pending")
  summary   String
  payload   Json
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status, createdAt])
}

model NotificationSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique
  telegramUserId       String?
  dailyCheckinEnabled  Boolean  @default(false)
  dailyCheckinTime     String?
  dailyInsightEnabled  Boolean  @default(false)
  dailyInsightTime     String?
  weeklyInsightEnabled Boolean  @default(false)
  weeklyInsightDay     String?
  weeklyInsightTime    String?
  timezone             String   @default("Europe/Madrid")
  defaultActionTimeMinutes Int   @default(540)
  morningTimeMinutes       Int   @default(540)
  afternoonTimeMinutes     Int   @default(900)
  eveningTimeMinutes       Int   @default(1140)
  tonightTimeMinutes       Int   @default(1200)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id          String   @id @default(uuid())
  userId      String
  type        String
  sentForDate String
  sentAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, type, sentForDate])
}

model IntegrationConnection {
  id            String   @id @default(uuid())
  userId        String
  integrationId String
  status        String   @default("active")
  config        Json
  lastSyncedAt  DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncLogs IntegrationSyncLog[]
  emailSignalRules EmailSignalRule[]
  emailReviewItems  EmailReviewItem[]

  @@index([userId])
  @@index([userId, integrationId])
}

model IntegrationSyncLog {
  id            String    @id @default(uuid())
  userId        String
  connectionId  String
  integrationId String
  status        String
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  eventsCreated Int       @default(0)
  error         String?

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([connectionId])
}

model EmailSignalRule {
  id                  String    @id @default(uuid())
  userId              String
  connectionId        String
  goalId              String?
  adapterId           String
  name                String
  query               String?
  status              String    @default("active")
  fetchStrategy       String    @default("query")
  lookbackDays        Int       @default(30)
  maxMessagesPerSync  Int       @default(25)
  maxEventsPerSync    Int       @default(10)
  classifierMode      String    @default("rules")
  minAutoLogConfidence Float    @default(0.9)
  minReviewConfidence Float     @default(0.65)
  reviewBeforeLogging Boolean   @default(false)
  createdBy           String
  lastSyncedAt        DateTime?
  lastError           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  reviewItems EmailReviewItem[]

  @@index([userId])
  @@index([connectionId])
  @@index([userId, status])
}

model EmailReviewItem {
  id                 String    @id @default(uuid())
  userId             String
  connectionId       String
  ruleId             String
  adapterId          String
  provider           String
  providerMessageId  String
  externalId         String    @unique
  subject            String?
  from               String?
  snippet            String?
  evidence           String?
  proposedEventType  String?
  confidence         Float
  reason             String
  extracted          Json
  status             String    @default("pending")
  eventId            String?
  actionItemId        String?
  archiveReason      String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  rule       EmailSignalRule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([ruleId, status])
}

model ActionItem {
  id             String    @id @default(uuid())
  userId         String
  source         String
  sourceId       String?
  sourceProvider String?
  sourceRuleId   String?
  title          String
  description    String?
  status         String    @default("open")
  priority       String    @default("medium")
  dueAt          DateTime?
  project        String?
  actionType     String?
  evidence       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?
  snoozedUntil   DateTime?

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminderLogs ActionItemReminderLog[]

  @@index([userId, status])
  @@index([userId, dueAt])
  @@index([source, sourceId])
}

model ActionItemReminderLog {
  id           String   @id @default(uuid())
  userId       String
  actionItemId String
  reminderType String
  sentAt       DateTime @default(now())
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionItem ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([actionItemId, reminderType, sentAt])
}

enum GoalStatus {
  active
  paused
  archived
}
