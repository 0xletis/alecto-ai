generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goals            Goal[]
  events           Event[]
  operatingProfile UserOperatingProfile?
  pendingActions   PendingAction[]
}

model Goal {
  id            String     @id @default(uuid())
  userId        String
  title         String
  category      String
  status        GoalStatus @default(active)
  why           String?
  templateId    String?
  targetMetrics Json?
  checkInConfig Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Event {
  id         String   @id @default(uuid())
  userId     String
  type       String
  timestamp  DateTime
  source     String
  data       Json
  confidence Float
  evidence   Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, timestamp])
}

model UserOperatingProfile {
  id                       String   @id @default(uuid())
  userId                   String   @unique
  directness               Int      @default(3)
  warmth                   Int      @default(3)
  humor                    Int      @default(2)
  confrontation            Int      @default(3)
  verbosity                Int      @default(3)
  profanityAllowed         Boolean  @default(false)
  motivationalStyle        String   @default("strategic")
  accountabilityStrictness Int      @default(3)
  reminderFrequency        String   @default("medium")
  escalationStyle          String   @default("firm")
  requiresEvidence         Boolean  @default(true)
  gamblingGuardrails       String   @default("strict")
  selfDeceptionSensitivity Int      @default(4)
  cooldownPreference       String   @default("require_confirmation")
  vulnerableMode           String   @default("soften")
  avoidingMode             String   @default("challenge")
  impulsiveMode            String   @default("guardian_mode")
  effectivePhrases         Json?
  ineffectivePhrases       Json?
  knownTriggers            Json?
  knownFailureModes        Json?
  knownStrengths           Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PendingAction {
  id        String    @id @default(uuid())
  userId    String
  type      String
  status    String    @default("pending")
  summary   String
  payload   Json
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status, createdAt])
}

enum GoalStatus {
  active
  paused
  archived
}
